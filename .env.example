# Vorlage fuer .env.local — echte Werte niemals committen.

# --- Quelle (Stufe 1) ---
BLOG_URL=https://unit.cloud/news-blog/
SCRAPE_USER_AGENT=unit.cloud-autoposter/1.0 (+https://unit.cloud)

# --- Datenhaltung (Stufe 1) ---
DATABASE_PATH=data/app.db

# --- LinkedIn (Stufe 4) ---
# Trockenlauf: true = Requests werden nur geloggt, nichts wird gesendet.
LINKEDIN_DRY_RUN=true
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
# Tatsaechlich bewilligte Scopes stehen nach der App-Freigabe im Developer-Portal.
LINKEDIN_SCOPES=w_organization_social,r_organization_social,w_member_social,rw_organization_admin
# Pflicht-Header LinkedIn-Version im Format YYYYMM.
LINKEDIN_API_VERSION=202606
# 32 Byte als Hex (64 Zeichen) fuer AES-256-GCM, erzeugt mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
